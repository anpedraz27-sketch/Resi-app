{
    "colors": {
        "primary": {
            "50": "#eef2ff",
            "100": "#e0e7ff",
            "200": "#c7d2fe",
            "300": "#a5b4fc",
            "400": "#818cf8",
            "500": "#6366f1",
            "600": "#4f46e5",
            "700": "#4338ca",
            "800": "#3730a3",
            "900": "#312e81",
            "950": "#1e1b4b"
        },
        "emerald": {
            "50": "#ecfdf5",
            "100": "#d1fae5",
            "200": "#a7f3d0",
            "300": "#6ee7b7",
            "400": "#34d399",
            "500": "#10b981",
            "600": "#059669",
            "700": "#047857",
            "800": "#065f46",
            "900": "#064e3b",
            "950": "#022c22"
        }
    },
    "typography": {
        "fontFamily": {
            "sans": [
                "Inter",
                "sans-serif"
            ]
        },
        "fontSize": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        },
        "hierarchies": {
            "h1": {
                "fontSize": "4xl",
                "fontWeight": "700",
                "lineHeight": "tight"
            },
            "h2": {
                "fontSize": "3xl",
                "fontWeight": "600",
                "lineHeight": "snug"
            },
            "h3": {
                "fontSize": "2xl",
                "fontWeight": "600",
                "lineHeight": "snug"
            },
            "body": {
                "fontSize": "base",
                "fontWeight": "400",
                "lineHeight": "normal"
            },
            "small": {
                "fontSize": "sm",
                "fontWeight": "400",
                "lineHeight": "normal"
            }
        }
    },
    "spacing": {
        "1": "0.25rem",
        "2": "0.5rem",
        "3": "0.75rem",
        "4": "1rem",
        "5": "1.25rem",
        "6": "1.5rem",
        "8": "2rem",
        "10": "2.5rem",
        "12": "3rem",
        "16": "4rem",
        "20": "5rem",
        "24": "6rem"
    },
    "shadows": {
        "soft": "0 4px 20px -2px rgba(0, 0, 0, 0.05)",
        "medium": "0 10px 25px -3px rgba(0, 0, 0, 0.1)"
    },
    "borderRadius": {
        "button": "0.5rem",
        "card": "1rem",
        "pill": "9999px"
    },
    "components": {
        "button": {
            "primary": {
                "base": "inline-flex items-center justify-center rounded-lg font-medium transition-colors duration-200",
                "default": "bg-primary-600 text-white hover:bg-primary-700 active:bg-primary-800",
                "size": {
                    "sm": "px-3 py-1.5 text-sm",
                    "md": "px-4 py-2 text-base",
                    "lg": "px-6 py-3 text-lg"
                }
            }
        },
        "card": {
            "base": "bg-white rounded-[16px] shadow-soft overflow-hidden border border-slate-100",
            "inner": "p-6"
        }
    }
}